<%- include('shared/header', { title }) %>
<h2>Register</h2>
<form method="post" action="/register">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <label>Email
    <input name="email" type="email" value="<%= values.email || '' %>" required />
  </label>
  <% if (errors.email) { %><p class="error"><%= errors.email %></p><% } %>

  <label>Password
    <input name="password" type="password" required minlength="8" />
  </label>
  <% if (errors.password) { %><p class="error"><%= errors.password %></p><% } %>

  <label>Confirm Password
    <input name="confirmPassword" type="password" required minlength="8" />
  </label>
  <% if (errors.confirmPassword) { %><p class="error"><%= errors.confirmPassword %></p><% } %>

  <button type="submit">Create account</button>
</form>
<p>Already have an account? <a href="/login">Login</a></p>
<%- include('shared/footer') %>

